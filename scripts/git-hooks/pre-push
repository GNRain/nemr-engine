#!/usr/bin/env bash
#
# Structural guard for a lapse that recurred twice in WP-J: pushing code that
# was clippy-checked but not `cargo fmt`-checked, so CI's lint job rejected it
# only after a push round-trip. `cargo fmt --all -- --check` is fast (it parses,
# it does not build), so running it before every push is cheap insurance.
#
# Installed by `git config core.hooksPath scripts/git-hooks` (done by
# scripts/setup_host.sh). To bypass in a genuine emergency: `git push --no-verify`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    printf '\033[31mpre-push blocked:\033[0m the tree is not rustfmt-clean.\n' >&2
    printf 'Run  \033[1mcargo fmt --all\033[0m  and commit, then push again.\n' >&2
    printf '(Emergency bypass: git push --no-verify)\n' >&2
    exit 1
fi

# The privileged helper is a separate workspace; CI checks it too.
if [[ -f deploy/nemr-volume/Cargo.toml ]]; then
    if ! (cd deploy/nemr-volume && cargo fmt --all -- --check >/dev/null 2>&1); then
        printf '\033[31mpre-push blocked:\033[0m deploy/nemr-volume is not rustfmt-clean.\n' >&2
        printf 'Run  \033[1m(cd deploy/nemr-volume && cargo fmt --all)\033[0m  and commit.\n' >&2
        exit 1
    fi
fi
