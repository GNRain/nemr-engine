{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/git_destructive_guard.sh",
            "timeout": 15,
            "statusMessage": "git guard: verifying the tree is clean"
          }
        ]
      }
    ]
  }
}
